{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenegadeBox",
  "version": "0.1.0",
  "identifier": "com.renegadebox.desktop",
  "build": {
    "beforeDevCommand": "bun run build:frontend",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RenegadeBox",
        "url": "index.html",
        "width": 1040,
        "height": 700,
        "minWidth": 840,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
