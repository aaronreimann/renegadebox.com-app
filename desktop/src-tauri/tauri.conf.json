{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenegadeBox",
  "version": "0.1.0",
  "identifier": "com.renegadebox.desktop",
  "build": {
    "beforeDevCommand": "bun run build:frontend",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "RenegadeBox",
        "url": "index.html",
        "width": 360,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "minimizable": false,
        "maximizable": false,
        "closable": false,
        "fullscreen": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
