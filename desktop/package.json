{
  "name": "@renegadebox/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "bun build src/main.ts --outfile src/main.js --format iife",
    "dev": "bun run build:frontend && PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH\" tauri dev",
    "build": "bun run build:frontend && PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$HOME/.local/bin:$PATH\" tauri build",
    "test": "bun test",
    "icons": "bun scripts/generate-icons.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
