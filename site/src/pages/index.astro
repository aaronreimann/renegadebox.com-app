---
import Layout from "../layouts/Layout.astro";
---

<Layout title="RenegadeBox — Zero-Knowledge S3 Folder Sync">
  <!-- Hero Section -->
  <section style="padding: 5rem 0 4rem 0; position: relative;">
    <div class="container" style="text-align: center;">
      <!-- Pill Badge -->
      <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.875rem; border-radius: 9999px; background: rgba(56, 189, 248, 0.08); border: 1px solid rgba(56, 189, 248, 0.25); color: #7dd3fc; font-size: 0.8125rem; font-weight: 600; margin-bottom: 2rem; backdrop-filter: blur(8px);">
        <span style="width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: #38bdf8; box-shadow: 0 0 10px #38bdf8; display: inline-block;"></span>
        Open-Source BYOS Dropbox Alternative
      </div>

      <!-- Main Headline -->
      <h1 style="font-size: clamp(2.5rem, 5.5vw, 4.25rem); font-weight: 900; letter-spacing: -0.03em; max-width: 950px; margin: 0 auto 1.5rem auto; line-height: 1.1;">
        Own Your Cloud.<br />
        Keep Your Files.<br />
        <span class="gradient-cyan">Trust No One.</span>
      </h1>

      <!-- Subtitle -->
      <p style="font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--text-secondary); max-width: 720px; margin: 0 auto 2.5rem auto; line-height: 1.6;">
        RenegadeBox syncs your folders directly into your own AWS S3, Cloudflare R2, or Backblaze B2 bucket. 
        Every byte and file name is encrypted with AES-256-GCM before upload.
        Zero SaaS markups. Zero plaintext leaks.
      </p>

      <!-- CTAs & Command Box -->
      <div style="display: flex; flex-direction: column; align-items: center; gap: 1.5rem; margin-bottom: 3.5rem;">
        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem;">
          <a href="#quickstart" class="btn btn-primary" style="padding: 0.875rem 2rem; font-size: 1rem;">
            Install CLI Quickstart
          </a>
          <a href="#zero-knowledge" class="btn btn-secondary" style="padding: 0.875rem 2rem; font-size: 1rem;">
            How Encryption Works
          </a>
        </div>

        <!-- Terminal Command Box -->
        <div style="display: flex; align-items: center; background: #0c1017; border: 1px solid var(--border-subtle); border-radius: 0.625rem; padding: 0.5rem 0.75rem 0.5rem 1.25rem; gap: 1rem; max-width: 520px; width: 100%; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);">
          <span style="color: var(--accent-cyan); font-family: var(--font-mono); font-size: 0.875rem;">$</span>
          <code id="cli-cmd" style="font-size: 0.8125rem; color: #e2e8f0; flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            cargo install --path engine --root ~/.local
          </code>
          <button
            type="button"
            id="copy-cmd-btn"
            style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.1); color: var(--text-primary); border-radius: 0.375rem; padding: 0.375rem 0.75rem; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s;"
          >
            Copy
          </button>
        </div>
      </div>

      <!-- Trust Metrics Strip -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; max-width: 1000px; margin: 0 auto;">
        <div class="glass-card" style="padding: 1.25rem; text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--accent-cyan); font-family: var(--font-heading); margin-bottom: 0.25rem;">
            Zero-Knowledge
          </div>
          <div style="font-size: 0.8125rem; color: var(--text-muted);">AES-256-GCM + Argon2id</div>
        </div>

        <div class="glass-card" style="padding: 1.25rem; text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 800; color: var(--accent-emerald); font-family: var(--font-heading); margin-bottom: 0.25rem;">
            &lt; 600 ms
          </div>
          <div style="font-size: 0.8125rem; color: var(--text-muted);">Real-Time WebSocket Push</div>
        </div>

        <div class="glass-card" style="padding: 1.25rem; text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 800; color: #a855f7; font-family: var(--font-heading); margin-bottom: 0.25rem;">
            BYOS S3
          </div>
          <div style="font-size: 0.8125rem; color: var(--text-muted);">AWS, Cloudflare R2, B2</div>
        </div>

        <div class="glass-card" style="padding: 1.25rem; text-align: center;">
          <div style="font-size: 1.5rem; font-weight: 800; color: #f43f5e; font-family: var(--font-heading); margin-bottom: 0.25rem;">
            100% Native
          </div>
          <div style="font-size: 0.8125rem; color: var(--text-muted);">Rust Engine + OS Keyring</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Terminal Showcase -->
  <section style="padding: 3rem 0 5rem 0;">
    <div class="container">
      <div style="max-width: 900px; margin: 0 auto; background: #090d16; border: 1px solid rgba(56, 189, 248, 0.2); border-radius: 0.875rem; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); overflow: hidden;">
        <!-- Terminal Header -->
        <div style="background: #0f1422; border-bottom: 1px solid var(--border-subtle); padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="width: 0.75rem; height: 0.75rem; border-radius: 9999px; background: #ef4444; display: inline-block;"></span>
            <span style="width: 0.75rem; height: 0.75rem; border-radius: 9999px; background: #f59e0b; display: inline-block;"></span>
            <span style="width: 0.75rem; height: 0.75rem; border-radius: 9999px; background: #10b981; display: inline-block;"></span>
            <span style="margin-left: 0.5rem; font-size: 0.75rem; color: var(--text-muted); font-family: var(--font-mono);">
              rbox watch — ~/RenegadeBox
            </span>
          </div>

          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <button
              id="simulate-sync-btn"
              style="background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.4); color: #7dd3fc; border-radius: 0.375rem; padding: 0.25rem 0.625rem; font-size: 0.75rem; font-family: var(--font-mono); cursor: pointer;"
            >
              ▶ Simulate File Event
            </button>
          </div>
        </div>

        <!-- Terminal Content -->
        <div id="terminal-screen" style="padding: 1.5rem; font-family: var(--font-mono); font-size: 0.8125rem; line-height: 1.7; color: #cbd5e1; min-height: 280px; overflow-x: auto;">
          <p style="color: var(--text-muted);"># Initializing encrypted vault and connecting to real-time hub...</p>
          <p><span style="color: var(--accent-cyan);">$</span> rbox watch</p>
          <p style="color: #6ee7b7;">[2026-10-15T21:00:00Z INFO] watching /Users/me/RenegadeBox (real-time via Hub at ws://localhost:8787/ws, remote fallback poll every 15s)</p>
          <p style="color: #6ee7b7;">[2026-10-15T21:00:01Z INFO] Authenticated with Hub (account: bdf038da-13bd-4f17-84d9-0bfb1646be65)</p>
          <p style="color: var(--text-muted);">[2026-10-15T21:00:01Z INFO] Vault unlocked. Master key loaded from macOS Keychain.</p>
          <div id="terminal-dynamic-lines"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Grid -->
  <section id="features" style="padding: 5rem 0; border-top: 1px solid var(--border-subtle); background: rgba(13, 17, 26, 0.4);">
    <div class="container">
      <div style="text-align: center; max-width: 650px; margin: 0 auto 4rem auto;">
        <h2 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Engineered for Privacy & Performance</h2>
        <p style="color: var(--text-secondary); font-size: 1rem;">
          No shortcuts, no third-party cloud analytics, and no compromise on zero-knowledge encryption.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem;">
        <!-- Feature 1 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.2); display: flex; align-items: center; justify-content: center; color: var(--accent-cyan); font-size: 1.25rem; margin-bottom: 1.25rem;">
            ☁️
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Bring Your Own Storage</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            Plug in your S3 credentials for AWS, Cloudflare R2 ($0 egress), Backblaze B2, or MinIO. Pay pennies directly to the storage provider rather than $15–$25/month for SaaS tiers.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); display: flex; align-items: center; justify-content: center; color: var(--accent-emerald); font-size: 1.25rem; margin-bottom: 1.25rem;">
            🔐
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Zero-Knowledge Cryptography</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            File contents and directory structures are encrypted into AES-256-GCM 4MB chunks. The S3 bucket and relay hub only ever see opaque blob hashes and ciphertext.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.2); display: flex; align-items: center; justify-content: center; color: #c084fc; font-size: 1.25rem; margin-bottom: 1.25rem;">
            ⚡
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Sub-Second WebSocket Relay</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            When Device A updates a file, a lightweight notification bounces through the WebSocket Hub and Postgres LISTEN/NOTIFY. Connected devices download the update in under 600ms.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); display: flex; align-items: center; justify-content: center; color: #fbbf24; font-size: 1.25rem; margin-bottom: 1.25rem;">
            📜
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Append-Only Journals</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            Each device writes to its own append-only journal in S3 using conditional writes (<code style="font-size: 0.8rem; background: rgba(255,255,255,0.06); padding: 0.15rem 0.35rem; border-radius: 0.25rem;">If-None-Match</code>). No locking, no centralized manifest bottlenecks.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.2); display: flex; align-items: center; justify-content: center; color: #fb7185; font-size: 1.25rem; margin-bottom: 1.25rem;">
            🔑
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">OS Keychain Protected</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            Your S3 secret keys and Argon2id master vault keys never touch plain text files. They are saved directly into macOS Keychain, Windows Credential Manager, or Linux Secret Service.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="glass-card" style="padding: 2rem;">
          <div style="width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.2); display: flex; align-items: center; justify-content: center; color: #38bdf8; font-size: 1.25rem; margin-bottom: 1.25rem;">
            🛡️
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.75rem;">Automatic Conflict Preservation</h3>
          <p style="color: var(--text-secondary); font-size: 0.9375rem; line-height: 1.6;">
            If two devices edit the same file simultaneously while offline, Lamport clock ordering converges deterministically. Conflicted copies are preserved so zero user data is ever lost.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zero-Knowledge Cryptography Architecture Explorer -->
  <section id="zero-knowledge" style="padding: 6rem 0; border-top: 1px solid var(--border-subtle); position: relative;">
    <div class="container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 4rem auto;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(16, 185, 129, 0.1); border: 1px solid var(--border-emerald); color: #6ee7b7; font-size: 0.75rem; font-weight: 600; margin-bottom: 1rem;">
          Verified by Automated Leak Probes (ISC-29 &amp; ISC-100)
        </div>
        <h2 style="font-size: 2.25rem; margin-bottom: 0.75rem;">What S3 and the Hub Never See</h2>
        <p style="color: var(--text-secondary); font-size: 1rem;">
          Commercial cloud providers scan and index your files. RenegadeBox isolates plaintext strictly to your physical hardware.
        </p>
      </div>

      <!-- 3-Zone Architecture Cards -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; margin-bottom: 3.5rem;">
        <!-- Zone 1: Your Device -->
        <div class="glass-card" style="padding: 1.75rem; border-top: 3px solid var(--accent-emerald);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #6ee7b7;">Zone 1</span>
            <span style="background: rgba(16, 185, 129, 0.15); color: #6ee7b7; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">Plaintext Only</span>
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Your Local Machine</h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem; line-height: 1.6;">
            Where your real files reside. The Rust engine decrypts files locally for editing and encrypts new versions before they leave memory.
          </p>
          <div style="background: #090e17; border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 0.875rem; font-family: var(--font-mono); font-size: 0.75rem; color: #94a3b8;">
            <div style="color: #6ee7b7; margin-bottom: 0.25rem;">✓ ~/RenegadeBox/taxes.pdf</div>
            <div style="color: #6ee7b7; margin-bottom: 0.25rem;">✓ OS Keychain (Master Key)</div>
            <div style="color: #6ee7b7;">✓ Local SQLite Cache (state.db)</div>
          </div>
        </div>

        <!-- Zone 2: The S3 Bucket -->
        <div class="glass-card" style="padding: 1.75rem; border-top: 3px solid var(--accent-cyan);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #7dd3fc;">Zone 2</span>
            <span style="background: rgba(56, 189, 248, 0.15); color: #7dd3fc; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">Opaque Blobs</span>
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Your S3 Bucket</h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem; line-height: 1.6;">
            AWS, Cloudflare R2, or Backblaze B2. Holds encrypted 4MB chunked blobs and append-only device journals. Zero file names or directory paths.
          </p>
          <div style="background: #090e17; border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 0.875rem; font-family: var(--font-mono); font-size: 0.75rem; color: #94a3b8;">
            <div style="color: #7dd3fc; margin-bottom: 0.25rem;">• rb/blobs/b4/b498e820...</div>
            <div style="color: #7dd3fc; margin-bottom: 0.25rem;">• rb/journal/&lt;uuid&gt;/00000000000000000008</div>
            <div style="color: #7dd3fc;">• rb/vault.json (Wrapped Master Key)</div>
          </div>
        </div>

        <!-- Zone 3: The Control Plane -->
        <div class="glass-card" style="padding: 1.75rem; border-top: 3px solid var(--accent-purple);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
            <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #d8b4fe;">Zone 3</span>
            <span style="background: rgba(168, 85, 247, 0.15); color: #d8b4fe; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 600;">Opaque Relay Only</span>
          </div>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">The WebSocket Hub</h3>
          <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.25rem; line-height: 1.6;">
            A lightweight relay that fan-outs "sync_required" pings between your online machines. Never touches storage or receives encryption keys.
          </p>
          <div style="background: #090e17; border: 1px solid var(--border-subtle); border-radius: 0.5rem; padding: 0.875rem; font-family: var(--font-mono); font-size: 0.75rem; color: #94a3b8;">
            <div style="color: #d8b4fe; margin-bottom: 0.25rem;">• &#123; origin_device: &quot;...&quot;, seq: 8 &#125;</div>
            <div style="color: #d8b4fe; margin-bottom: 0.25rem;">• Postgres LISTEN/NOTIFY fanout</div>
            <div style="color: #d8b4fe;">• 256-bit CSPRNG token validation</div>
          </div>
        </div>
      </div>

      <!-- Interactive Perspective Switcher -->
      <div class="glass-card" style="padding: 2.5rem; max-width: 900px; margin: 0 auto; background: #0a0e18;">
        <h3 style="font-size: 1.35rem; margin-bottom: 0.5rem; text-align: center;">Interactive Payload Inspector</h3>
        <p style="text-align: center; color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1.75rem;">
          Compare what is visible on your machine against what reaches the S3 bucket and the WebSocket Hub.
        </p>

        <!-- Tabs -->
        <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
          <button
            id="tab-client"
            style="background: rgba(16, 185, 129, 0.2); border: 1px solid var(--border-emerald); color: #6ee7b7; padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer;"
          >
            1. Your Device (Plaintext)
          </button>
          <button
            id="tab-s3"
            style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle); color: var(--text-secondary); padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer;"
          >
            2. In S3 Bucket (Ciphertext)
          </button>
          <button
            id="tab-hub"
            style="background: rgba(255, 255, 255, 0.05); border: 1px solid var(--border-subtle); color: var(--text-secondary); padding: 0.5rem 1.25rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer;"
          >
            3. On Hub Wire (Envelopes)
          </button>
        </div>

        <!-- Perspective Output Box -->
        <div id="perspective-box" style="background: #060910; border: 1px solid var(--border-subtle); border-radius: 0.625rem; padding: 1.25rem; font-family: var(--font-mono); font-size: 0.8125rem; min-height: 180px; overflow-x: auto;">
          <div style="color: #6ee7b7; margin-bottom: 0.5rem;">// Plaintext file on your MacBook:</div>
          <div style="color: #f8fafc; font-weight: 600;">Path: /Users/me/RenegadeBox/Documents/Taxes/2026-Receipts.pdf</div>
          <div style="color: var(--text-muted); margin-top: 0.5rem;">File size: 3,421,800 bytes</div>
          <div style="color: var(--text-muted);">Plaintext hash: e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855</div>
          <div style="color: var(--accent-emerald); margin-top: 0.75rem;">Status: Decrypted in local memory. Never transmitted over network without encryption.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cloud Storage Setup Wizard -->
  <section id="wizard" style="padding: 6rem 0; border-top: 1px solid var(--border-subtle); position: relative;">
    <div class="container">
      <div style="text-align: center; max-width: 720px; margin: 0 auto 3.5rem auto;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(56, 189, 248, 0.1); border: 1px solid var(--border-cyan); color: #7dd3fc; font-size: 0.75rem; font-weight: 600; margin-bottom: 1rem;">
          Bring Your Own Storage (BYOS)
        </div>
        <h2 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Interactive S3 Provider Setup Wizard</h2>
        <p style="color: var(--text-secondary); font-size: 1rem;">
          Select your storage provider below. RenegadeBox automatically generates the exact minimal IAM policy and CLI command to connect your vault in seconds.
        </p>
      </div>

      <div class="glass-card" style="padding: 2.5rem; max-width: 960px; margin: 0 auto;">
        <!-- Provider Buttons -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem; margin-bottom: 2rem;">
          <button
            type="button"
            id="provider-btn-r2"
            class="wizard-provider-btn"
            style="background: rgba(56, 189, 248, 0.15); border: 1px solid var(--accent-cyan); color: #7dd3fc; padding: 1rem; border-radius: 0.5rem; cursor: pointer; text-align: left; display: flex; flex-direction: column; gap: 0.25rem;"
          >
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-weight: 700; font-size: 0.95rem;">Cloudflare R2</span>
              <span style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; font-size: 0.7rem; padding: 0.15rem 0.4rem; border-radius: 0.25rem;">$0 Egress</span>
            </div>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Recommended for high bandwidth</span>
          </button>

          <button
            type="button"
            id="provider-btn-s3"
            class="wizard-provider-btn"
