---
import Layout from "../layouts/Layout.astro";
---

<Layout title="RenegadeBox — Zero-Knowledge S3 Folder Sync">
  <div class="container" style="padding-top: 5rem; padding-bottom: 5rem; text-align: center;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">Own Your Cloud. Keep Your Files. Trust No One.</h1>
    <p style="font-size: 1.25rem; color: var(--text-secondary); max-width: 600px; margin: 0 auto;">
      The open-source, end-to-end-encrypted Dropbox alternative syncing into your own S3 bucket.
    </p>
  </div>
</Layout>
