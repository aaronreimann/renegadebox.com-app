---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  activeDoc?: string;
}

const { title, activeDoc = "" } = Astro.props;

const docNav = [
  { slug: "index", title: "Overview & Index", href: "/docs" },
  { slug: "quickstart", title: "Quickstart Guide", href: "/docs/quickstart" },
  { slug: "architecture", title: "Zero-Knowledge Architecture", href: "/docs/architecture" },
  { slug: "providers", title: "Storage Providers (R2, S3, B2)", href: "/docs/providers" },
  { slug: "cli", title: "CLI Command Reference", href: "/docs/cli" },
];
---

<Layout title={`${title} — RenegadeBox Docs`}>
  <div class="container" style="padding-top: 3rem; padding-bottom: 6rem;">
    <div style="display: grid; grid-template-columns: 260px 1fr; gap: 3.5rem; align-items: start;">
      <!-- Sticky Sidebar -->
      <aside style="position: sticky; top: 6rem; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 0.75rem; padding: 1.5rem; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 1rem;">
          Documentation
        </div>
        <nav style="display: flex; flex-direction: column; gap: 0.375rem;">
          {docNav.map((item) => (
            <a
              href={item.href}
              style={`padding: 0.5rem 0.75rem; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 500; transition: all 0.2s; display: block; ${
                activeDoc === item.slug
                  ? "background: rgba(56, 189, 248, 0.15); color: #7dd3fc; border-left: 3px solid var(--accent-cyan); font-weight: 600;"
                  : "color: var(--text-secondary); hover:color: #ffffff;"
              }`}
            >
              {item.title}
            </a>
          ))}
        </nav>

        <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
          <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 0.75rem;">
            Quick Links
          </div>
          <a
            href="http://localhost:3000"
            target="_blank"
            style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: #6ee7b7; padding: 0.25rem 0;"
          >
            <span>Live Dashboard →</span>
          </a>
          <a
            href="https://github.com/aaronreimann/renegadebox.com-app"
            target="_blank"
            style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--text-muted); padding: 0.25rem 0;"
          >
            <span>GitHub Repository ↗</span>
          </a>
        </div>
      </aside>

      <!-- Main Docs Content Area -->
      <main class="docs-content" style="max-width: 820px; line-height: 1.7;">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<style>
  @media (max-width: 840px) {
    div[style*="grid-template-columns: 260px 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 2rem !important;
    }
    aside {
      position: static !important;
      top: auto !important;
    }
  }

  .docs-content :global(h1) {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .docs-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .docs-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #e2e8f0;
  }

  .docs-content :global(p) {
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
  }

  .docs-content :global(ul), .docs-content :global(ol) {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    font-size: 0.95rem;
  }

  .docs-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .docs-content :global(code) {
    background: #090e18;
    color: #7dd3fc;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .docs-content :global(pre) {
    background: #090e18;
    border: 1px solid var(--border-subtle);
    border-radius: 0.5rem;
    padding: 1.25rem;
    font-size: 0.8125rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .docs-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    color: #f1f5f9;
  }
</style>
